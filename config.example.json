{
  "server": {
    "listen": "127.0.0.1",
    "port": 10830,
    "direct_slots": 16,
    "proxy_slots": 16,
    "max_connections": 256,
    "ingress_wait_timeout": 5.0,
    "connect_timeout": 12.0,
    "total_egress_deadline": 20.0,
    "headers_timeout": 120.0,
    "inactivity_timeout": 300.0,
    "body_timeout": 30.0,
    "body_buffer_max_bytes": 16777216,
    "pre_send_retries": 1,
    "geo_cache_ttl_seconds": 86400,
    "proxy_fail_penalty_seconds": 30,
    "retry_sleep_seconds": 0.5,
    "retry_backoff_factor": 2.0,
    "retry_max_sleep_seconds": 3.0,
    "geo_cache_file": "~/.config/model-georouter/geo_cache.json"
  },
  "pools": {
    "direct": { "type": "direct" },
    "route-de": {
      "type": "http_connect",
      "strategy": "first_available",
      "proxies": ["http://127.0.0.1:10820"]
    },
    "route-sg": {
      "type": "http_connect",
      "strategy": "first_available",
      "proxies": ["http://user:pass@sg-node-1.example:3128", "http://user:pass@sg-node-2.example:3128"]
    },
    "route-hy2": {
      "type": "socks5",
      "remote_dns": true,
      "proxies": ["socks5h://127.0.0.1:10821"]
    }
  },
  "upstreams": {
    "vendor-ai": { "host": "api.vendor.example", "base_path": "/v1" }
  },
  "adapters": {
    "sg-vendor": {
      "prefixes": ["/sg-vendor"],
      "upstream": "vendor-ai",
      "pool": "route-sg"
    }
  },
  "rules": [
    { "match_prefix": ["vendor-model-1"], "pool": "route-sg", "description": "точное правило: только этот id в SG, до общего правила" },
    { "match_prefix": ["claude-", "gpt-"], "pool": "route-de", "description": "модели с гео-ограничениями" },
    { "match_regex": "^gemini-.*-preview$", "pool": "route-hy2" }
  ],
  "default_pool": "direct",
  "geo_fallback_pool": "route-de"
}
